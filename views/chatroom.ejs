<header class="app-header">
  <div class="header-inner">
    <a href="/feed" class="brand">
      <span class="logo-icon">💬</span>
      <span>ClassChat</span>
    </a>
    <nav class="nav-links">
      <a href="/feed">Feed</a>
      <a href="/u/<%= username %>">Profile</a>
      <a href="/messages" class="active">Messages</a>
      <a href="/friends"><% if (typeof pendingFriendRequestsCount !== 'undefined' && pendingFriendRequestsCount) { %><span class="nav-badge"><%= pendingFriendRequestsCount %></span> <% } %>Friends</a>
      <a href="/activity"><% if (typeof unreadActivityCount !== 'undefined' && unreadActivityCount) { %><span class="nav-badge"><%= unreadActivityCount %></span> <% } %>Activity</a>
      <a href="/saved">Saved</a>
      <a href="/search">Search</a>
      <% if (typeof is_staff !== 'undefined' && is_staff) { %><a href="/staff/dashboard">Staff</a><% } %>
    </nav>
    <div class="header-right">
      <span class="user-badge">@<%= username %></span>
      <a href="/logout" class="btn btn-ghost">Log out</a>
    </div>
  </div>
</header>

<main class="conversation-page chatroom-page">
  <div class="chat-container">
    <div class="conversation-header chatroom-top-header">
      <div class="chat-header-left">
        <a href="/messages" class="chat-back-btn" title="Back to messages">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </a>
        <div class="chatroom-header-info">
          <div class="chatroom-title-row">
            <h1 class="chatroom-title-text" id="chatroom-title-display"><%= room.name %></h1>
            <% if (room.type === 'public') { %>
              <span class="room-pill room-pill-public">🌐 Public Chatroom</span>
            <% } else { %>
              <span class="room-pill room-pill-group">👥 Group Chatroom</span>
            <% } %>
          </div>
          <span class="chatroom-meta-text muted">
            <% if (room.type === 'public') { %>
              Open to all students &amp; staff
            <% } else { %>
              <span id="chatroom-member-count"><%= members.length %> <%= members.length === 1 ? 'member' : 'members' %></span>
            <% } %>
          </span>
        </div>
      </div>

      <div class="chat-header-actions chatroom-header-actions">
        <% if (room.type === 'private') { %>
        <button type="button" class="btn btn-secondary btn-sm" id="btn-open-invite">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Invite Friends</span>
        </button>
        <% } %>

        <% if (canRename) { %>
        <button type="button" class="btn btn-ghost btn-sm" id="btn-open-rename" title="Rename this chatroom">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
          <span>Rename</span>
        </button>
        <% } %>

        <button type="button" class="btn btn-ghost btn-sm" id="btn-open-members" title="View Members">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span>Members (<%= members.length %>)</span>
        </button>

        <% if (room.type === 'private') { %>
        <form action="/chatrooms/<%= room.id %>/leave" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to leave this group chatroom?');">
          <button type="submit" class="btn btn-ghost btn-sm text-danger" title="Leave chatroom">Leave</button>
        </form>
        <% } %>

        <% if (is_staff) { %>
        <form action="/staff/chatrooms/<%= room.id %>/clear" method="post" style="display:inline;" onsubmit="return confirm('Staff Admin: Clear all messages in this chatroom?');">
          <button type="submit" class="btn btn-ghost btn-sm text-warning" title="Clear chat history">Clear History</button>
        </form>
        <% if (room.type === 'public' && room.name !== 'Chatroom 1' && room.name !== 'Chatroom 2' && room.name !== 'Chatroom 3') { %>
        <form action="/staff/chatrooms/<%= room.id %>/delete" method="post" style="display:inline;" onsubmit="return confirm('Staff Admin: Delete this entire chatroom?');">
          <button type="submit" class="btn btn-ghost btn-sm text-danger" title="Delete chatroom">Delete Room</button>
        </form>
        <% } %>
        <% } %>
      </div>
    </div>

    <!-- Messages Feed Area -->
    <div class="conversation-feed-wrapper">
      <div id="message-feed" class="conversation-messages" data-room-id="<%= room.id %>" data-current-user="<%= username %>" data-current-user-id="<%= userId %>" data-is-staff="<%= is_staff ? '1' : '0' %>">
        <div id="load-more-container" class="load-more-container" style="<%= (typeof hasMore !== 'undefined' && hasMore) ? '' : 'display:none;' %>">
          <button type="button" id="btn-load-more" class="btn btn-ghost btn-sm btn-load-more">↑ Load older messages</button>
          <div id="loading-older-spinner" class="loading-older-spinner" style="display:none;">Loading older messages...</div>
        </div>

        <% messages.forEach(function(m) { %>
        <div class="dm-message <%= m.sender_id === userId ? 'dm-sent' : 'dm-received' %>" data-message-id="<%= m.id %>">
          <% if (m.sender_id !== userId) { %>
            <a href="/u/<%= m.sender_username %>" class="message-user-avatar-link">
              <% if (m.sender_avatar) { %>
              <img src="<%= m.sender_avatar %>" alt="" class="dm-avatar">
              <% } else { %>
              <div class="dm-avatar dm-avatar-initial"><%= (m.sender_display_name || m.sender_username || '?').charAt(0).toUpperCase() %></div>
              <% } %>
            </a>
          <% } %>
          <div class="dm-bubble">
            <% if (m.reply_to_body) { %>
            <div class="dm-reply-to muted"><%= m.reply_to_body %><% if (m.reply_to_body.length >= 100) { %>…<% } %></div>
            <% } %>
            <% if (m.sender_id !== userId) { %>
              <span class="dm-sender">
                <strong><%= m.sender_display_name || m.sender_username %></strong>
                <span class="muted" style="font-size: 0.85em; font-weight: normal;">@<%= m.sender_username %></span>
              </span>
            <% } %>
            <% if (m.body) { %><p class="dm-body"><%= m.body %></p><% } %>
            <% if (m.image_path) { %>
            <div class="dm-attach"><img src="<%= m.image_path %>" alt="" class="dm-attach-img" loading="lazy"></div>
            <% } %>
            <% if (m.file_path) { %>
            <p class="dm-attach"><a href="<%= m.file_path %>" target="_blank" rel="noopener" class="dm-attach-link">📎 Download attachment</a></p>
            <% } %>
            <% if (m.video_path) { %>
            <div class="dm-attach"><video src="<%= m.video_path %>" controls class="dm-attach-video"></video></div>
            <% } %>
            <div class="dm-footer">
              <span class="dm-time muted"><%= m.created_at_fmt || m.created_at %></span>
              <div class="dm-actions">
                <button type="button" class="dm-action-btn reply-to-btn" data-message-id="<%= m.id %>" data-reply-body="<%= (m.body || '').slice(0, 50).replace(/"/g, '&quot;') %>">Reply</button>
                <% if (m.sender_id === userId || is_staff) { %>
                <button type="button" class="dm-action-btn dm-delete-btn" onclick="deleteRoomMsg(<%= m.id %>)">Delete</button>
                <% } %>
              </div>
            </div>
          </div>
        </div>
        <% }); %>

        <div id="room-empty-state" class="conversation-empty muted" style="<%= messages.length === 0 ? '' : 'display:none;' %>">
          <span class="empty-icon">💬</span>
          <p>No messages in <%= room.name %> yet. Be the first to start chatting!</p>
        </div>
      </div>

      <button type="button" id="new-message-pill" class="new-message-pill" style="display:none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        New messages
      </button>

      <div id="typing-indicator" class="typing-indicator" style="display:none;">
        <div class="typing-dots"><span></span><span></span><span></span></div>
        <span id="typing-text" class="typing-text">Someone is typing...</span>
      </div>
    </div>

    <!-- Message Composer -->
    <form id="chatroom-form" action="/chatrooms/<%= room.id %>/messages" method="post" enctype="multipart/form-data" class="conversation-form">
      <input type="hidden" name="reply_to" id="reply_to" value="">
      <% if (typeof error !== 'undefined' && error === 'empty') { %>
      <p class="form-error">Message or attachment required.</p>
      <% } %>
      <div id="reply-preview" class="reply-preview" style="display:none;">
        <div class="reply-preview-content">
          <span class="reply-preview-label">Replying:</span>
          <span id="reply-preview-text" class="reply-preview-text"></span>
        </div>
        <button type="button" id="reply-cancel" class="btn-ghost-sm" title="Cancel reply">&times;</button>
      </div>
      <div id="compose-preview-tray" class="compose-preview-tray" style="display:none;"></div>
      <div class="conversation-compose">
        <div class="compose-row">
          <div class="compose-attach-group">
            <label class="file-label btn-attach" title="Attach image">
              <input type="file" name="image" id="file-image" accept="image/*" class="file-input">
              <span>📷</span>
            </label>
            <label class="file-label btn-attach" title="Attach file">
              <input type="file" name="file" id="file-doc" class="file-input">
              <span>📎</span>
            </label>
            <label class="file-label btn-attach" title="Attach video">
              <input type="file" name="video" id="file-video" accept="video/*" class="file-input">
              <span>🎬</span>
            </label>
          </div>
          <div class="compose-input-wrapper">
            <textarea name="body" id="msg-body" placeholder="Message <%= room.name %>..." rows="1" maxlength="2000"></textarea>
          </div>
          <button type="submit" id="btn-send" class="btn btn-primary btn-chat-send" title="Send (Enter)">
            <span>Send</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
          </button>
        </div>
        <div class="compose-hint muted">
          <span>Enter to send · Shift+Enter for new line</span>
          <span>Max 5MB per file</span>
        </div>
      </div>
    </form>
  </div>
</main>

<!-- Rename Modal -->
<div id="rename-modal" class="custom-modal-overlay" style="display:none;">
  <div class="custom-modal-card">
    <div class="custom-modal-header">
      <h3>Rename Chatroom</h3>
      <button type="button" class="custom-modal-close" id="btn-close-rename-modal">&times;</button>
    </div>
    <form id="rename-form" action="/chatrooms/<%= room.id %>/rename" method="post" class="create-room-form">
      <div class="form-field">
        <label for="new-room-name" class="form-label">Chatroom Name</label>
        <input type="text" id="new-room-name" name="name" value="<%= room.name %>" maxlength="80" required class="input-text">
      </div>
      <div class="custom-modal-actions">
        <button type="button" class="btn btn-ghost" id="btn-cancel-rename-modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Name</button>
      </div>
    </form>
  </div>
</div>

<!-- Invite Friends Modal -->
<div id="invite-modal" class="custom-modal-overlay" style="display:none;">
  <div class="custom-modal-card">
    <div class="custom-modal-header">
      <h3>Invite Friends</h3>
      <button type="button" class="custom-modal-close" id="btn-close-invite-modal">&times;</button>
    </div>
    <% 
      const currentMemberIds = new Set(members.map(m => m.user_id));
      const uninvitedFriends = (typeof friends !== 'undefined' ? friends : []).filter(f => !currentMemberIds.has(f.id));
    %>
    <form id="invite-form" action="/chatrooms/<%= room.id %>/invite" method="post" class="create-room-form">
      <div class="form-field">
        <% if (uninvitedFriends.length > 0) { %>
        <label class="form-label">Select friends to invite to <%= room.name %></label>
        <div class="friends-invite-list">
          <% uninvitedFriends.forEach(function(f) { %>
          <label class="friend-checkbox-item">
            <input type="checkbox" name="friends" value="<%= f.id %>">
            <div class="friend-check-user">
              <% if (f.avatar_path) { %>
              <img src="<%= f.avatar_path %>" alt="" class="check-avatar">
              <% } else { %>
              <div class="check-avatar check-avatar-initial"><%= (f.display_name || f.username || '?').charAt(0).toUpperCase() %></div>
              <% } %>
              <div class="check-meta">
                <strong><%= f.display_name || f.username %></strong>
                <span class="muted">@<%= f.username %></span>
              </div>
            </div>
          </label>
          <% }); %>
        </div>
        <div class="custom-modal-actions">
          <button type="button" class="btn btn-ghost" id="btn-cancel-invite-modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Invite Selected</button>
        </div>
        <% } else { %>
        <p class="muted" style="padding: 12px 0;">All your friends are already in this chatroom!</p>
        <div class="custom-modal-actions">
          <button type="button" class="btn btn-primary" id="btn-close-invite-ok">Done</button>
        </div>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Members Modal -->
<div id="members-modal" class="custom-modal-overlay" style="display:none;">
  <div class="custom-modal-card">
    <div class="custom-modal-header">
      <h3>Chatroom Members (<%= members.length %>)</h3>
      <button type="button" class="custom-modal-close" id="btn-close-members-modal">&times;</button>
    </div>
    <div class="members-list-body">
      <ul class="chatroom-members-list">
        <% members.forEach(function(m) { %>
        <li class="chatroom-member-item">
          <a href="/u/<%= m.username %>" class="member-profile-link">
            <% if (m.avatar_path) { %>
            <img src="<%= m.avatar_path %>" alt="" class="member-avatar">
            <% } else { %>
            <div class="member-avatar member-avatar-initial"><%= (m.display_name || m.username || '?').charAt(0).toUpperCase() %></div>
            <% } %>
            <div class="member-info">
              <span class="member-name"><%= m.display_name || m.username %></span>
              <span class="member-username muted">@<%= m.username %></span>
            </div>
          </a>
          <div class="member-badges">
            <% if (m.role === 'owner') { %>
              <span class="member-role-badge owner-badge">Owner</span>
            <% } else { %>
              <span class="member-role-badge member-badge">Member</span>
            <% } %>
          </div>
        </li>
        <% }); %>
      </ul>
    </div>
    <div class="custom-modal-actions">
      <button type="button" class="btn btn-primary" id="btn-close-members-ok">Close</button>
    </div>
  </div>
</div>

<script src="/js/chatroom.js"></script>
