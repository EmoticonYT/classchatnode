<div class="whats-new-page-wrap">
  <div class="whats-new-ambient-glow"></div>

  <div class="auth-card whats-new-card">
    <div class="logo">
      <span class="logo-icon">💬</span>
      <h1 class="whats-new-title">
        <span>ClassChat</span>
        <span class="plus-badge-pill">Plus</span>
      </h1>
      <p class="tagline highlight-version">
        Welcome to ClassChat 4.0 Plus!
      </p>
      <p class="whats-new-subtitle">
        Our biggest update yet brings Discord-style community servers, live chat, and student spaces directly into ClassChat.
      </p>
    </div>

    <div class="whats-new-body">
      <div class="whats-new-groups-container">
        <!-- Feature 1: Community Servers & Channels -->
        <div class="whats-new-group">
          <h3 class="whats-new-section-title title-purple">
            <span class="feature-icon">🏰</span> Build Your Own Student Servers
          </h3>
          <ul class="whats-new-feature-list">
            <li><strong>Spaces for Everything:</strong> Create custom servers for study groups, sports teams, clubs, or just hanging out with friends, complete with custom icons and banners.</li>
            <li><strong>Topic Channels:</strong> Keep conversations organized with dedicated channels like <code class="plus-code-tag">#general</code>, <code class="plus-code-tag">#homework-help</code>, and <code class="plus-code-tag">#memes</code>.</li>
          </ul>
        </div>

        <!-- Feature 2: Real-Time Messaging & Reactions -->
        <div class="whats-new-group">
          <h3 class="whats-new-section-title title-blue">
            <span class="feature-icon">⚡</span> Live Real-Time Chat &amp; Reactions
          </h3>
          <ul class="whats-new-feature-list">
            <li><strong>Instant Messages:</strong> Chats appear live on your screen the moment anyone hits send — no refreshing needed.</li>
            <li><strong>Typing Bubbles &amp; Emojis:</strong> See when your friends are typing in real time, and react to any message with emojis to agree, celebrate, or laugh.</li>
          </ul>
        </div>

        <!-- Feature 3: Pins, Profiles & Search -->
        <div class="whats-new-group">
          <h3 class="whats-new-section-title title-amber">
            <span class="feature-icon">📌</span> Pinned Notes, Mini Profiles &amp; Search
          </h3>
          <ul class="whats-new-feature-list">
            <li><strong>Pin Important Stuff:</strong> Save assignment deadlines, meeting times, or essential links to the top of the channel so nobody loses them.</li>
            <li><strong>Member Mini-Cards:</strong> Click on anyone's avatar to see their role (Owner, Admin, Member), online status, and jump straight into a 1-on-1 private message.</li>
            <li><strong>In-Channel Search:</strong> Quickly find that link or note from last week with instant keyword search.</li>
          </ul>
        </div>

        <!-- Feature 4: Easy Invites -->
        <div class="whats-new-group">
          <h3 class="whats-new-section-title title-pink">
            <span class="feature-icon">💌</span> Instant One-Click Invites
          </h3>
          <ul class="whats-new-feature-list">
            <li><strong>Invite Friends Easily:</strong> Share your server's link or invite code with classmates so they can preview your server and join in a single click.</li>
          </ul>
        </div>
      </div>

      <form action="/whats-new/dismiss" method="post" class="whats-new-action-form">
        <button type="submit" class="btn btn-primary btn-block btn-start-chatting btn-plus-glow">
          <span>Start Exploring ClassChat Plus!</span>
          <span>🚀</span>
        </button>
      </form>
    </div>
  </div>
</div>
