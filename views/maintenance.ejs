<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Maintenance — ClassChat' %></title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0f0f12;
      color: #f0f0f5;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      text-align: center;
      padding: 24px;
    }
    .maintenance-card {
      max-width: 400px;
    }
    .maintenance-icon {
      font-size: 4rem;
      margin-bottom: 16px;
    }
    h1 {
      margin: 0 0 12px;
      font-size: 1.5rem;
      font-weight: 700;
    }
    p {
      margin: 0 0 24px;
      color: #8a8a9a;
      font-size: 0.95rem;
      line-height: 1.5;
    }
    a {
      color: #6366f1;
      text-decoration: none;
      font-size: 0.875rem;
    }
    a:hover { text-decoration: underline; }
    .maintenance-footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 16px 24px;
      border-top: 1px solid #2a2a32;
      text-align: right;
    }
    .maintenance-footer .footer-fine {
      font-size: 0.75rem;
      color: #8a8a9a;
    }
    .maintenance-footer .footer-fine a {
      color: #8a8a9a;
      text-decoration: none;
    }
    .maintenance-footer .footer-fine a:hover {
      color: #6366f1;
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="maintenance-card">
    <div class="maintenance-icon">🔧</div>
    <h1>Under maintenance</h1>
    <p>ClassChat is temporarily unavailable. Please try again later.</p>
  </div>
  <footer class="maintenance-footer">
    <p class="footer-fine">Staff: <a href="/maintenance-login.html">maintenance login</a></p>
  </footer>
</body>
</html>
