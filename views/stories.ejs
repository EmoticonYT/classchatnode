<header class="app-header">
  <div class="header-inner">
    <a href="/feed" class="brand"><span class="logo-icon">💬</span><span>ClassChat</span></a>
    <nav class="nav-links">
      <a href="/feed">Feed</a>
      <a href="/u/<%= username %>">Profile</a>
      <a href="/messages">Messages</a>
      <a href="/friends"><% if (pendingFriendRequestsCount) { %><span class="nav-badge"><%= pendingFriendRequestsCount %></span> <% } %>Friends</a>
      <a href="/activity"><% if (unreadActivityCount) { %><span class="nav-badge"><%= unreadActivityCount %></span> <% } %>Activity</a>
      <a href="/saved">Saved</a>
      <a href="/stories" class="active">Stories</a>
      <a href="/call-history">Calls</a>
      <a href="/search">Search</a>
      <a href="/settings">Settings</a>
    </nav>
    <div class="header-right">
      <span class="user-badge">@<%= username %></span>
      <a href="/logout" class="btn btn-ghost">Log out</a>
    </div>
  </div>
</header>
<main class="stories-page">
  <div class="page-title-bubble">
    <h1>Stories</h1>
    <p class="muted">Stories expire after 24 hours</p>
  </div>
  <% if (stories.length === 0) { %>
  <div class="empty-card">
    <p class="muted" style="margin:0;">No active stories. Stories expire after 24 hours.</p>
  </div>
  <% } else { %>
  <ul class="stories-list" style="list-style: none; padding: 0;">
    <% stories.forEach(function(s) { %>
    <li class="story-item" style="margin-bottom: 16px; padding: 16px; background: var(--bg-card); border-radius: var(--radius); border: 1px solid var(--border);">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
        <% if (s.avatar_path) { %><img src="<%= s.avatar_path %>" alt="" style="width: 40px; height: 40px; border-radius: 50%;"><% } else { %><div style="width: 40px; height: 40px; border-radius: 50%; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; font-weight: 600;"><%= (s.display_name || s.username || '?').charAt(0).toUpperCase() %></div><% } %>
        <span><strong style="font-weight: 600;"><%= s.display_name || s.username %></strong> <span class="muted" style="font-size: 0.85em; font-weight: normal;">@<%= s.username %></span></span>
        <span class="muted"><%= s.created_at %></span>
      </div>
      <% if (s.body) { %><p><%= s.body %></p><% } %>
      <% if (s.image_path) { %><img src="<%= s.image_path %>" alt="" style="max-width: 100%; border-radius: 8px;"><% } %>
      <% if (s.video_path) { %><video src="<%= s.video_path %>" controls style="max-width: 100%; border-radius: 8px;"></video><% } %>
    </li>
    <% }); %>
  </ul>
  <% } %>
</main>
