<div class="plus-layout-wrap">
  <!-- Left Server Rail (72px) -->
  <nav class="plus-server-rail" aria-label="Servers">
    <div class="plus-rail-item active" title="Discover Servers">
      <div class="plus-rail-pill"></div>
      <a href="/plus" class="plus-rail-btn discover-btn" aria-label="Discover Communities">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </a>
    </div>

    <div class="plus-rail-divider"></div>

    <!-- Joined Servers -->
    <% if (typeof userServers !== 'undefined' && userServers.length > 0) { %>
      <% userServers.forEach(function(s) { %>
        <div class="plus-rail-item" title="<%= s.name %>">
          <div class="plus-rail-pill"></div>
          <a href="/plus/server/<%= s.id %>" class="plus-rail-btn">
            <% if (s.icon_path) { %>
              <img src="<%= s.icon_path %>" alt="<%= s.name %>">
            <% } else { %>
              <%= s.name.split(' ').map(function(w) { return w[0]; }).join('').slice(0, 3).toUpperCase() %>
            <% } %>
          </a>
        </div>
      <% }); %>
    <% } %>

    <!-- Create Server Button -->
    <div class="plus-rail-item" title="Create a Server">
      <button type="button" class="plus-rail-btn create-btn" onclick="openPlusModal('create-server-modal')" aria-label="Create a Server">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Discover Main View -->
  <main class="plus-discover-main">
    <!-- Hero Banner -->
    <div class="plus-discover-hero">
      <h1>Find your community on ClassChat Plus</h1>
      <p>From school clubs and study groups to gaming squads and hangouts, there's a place for you. Discover open communities or start your own.</p>
      
      <div class="plus-discover-bar-row">
        <form action="/plus" method="GET" class="plus-search-input-wrap">
          <svg class="plus-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" name="q" class="plus-search-input" placeholder="Explore communities, clubs, and study groups..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        </form>
        <button type="button" class="btn btn-primary btn-plus-glow" onclick="openPlusModal('create-server-modal')">
          + Create a Server
        </button>
      </div>
    </div>

    <!-- Quick Join via 6-digit Code -->
    <div class="plus-quick-join-card">
      <div class="plus-quick-join-text">
        <h3>Have an invite code?</h3>
        <p>Enter a 6-character server code to join directly (e.g. <code>A8K2F9</code> or paste full invite link)</p>
      </div>
      <form onsubmit="event.preventDefault(); var c = document.getElementById('quick-invite-input').value.trim(); if(c){ var code = c.split('/').pop().toUpperCase(); window.location.href='/plus/invite/' + code; }" class="plus-quick-join-form">
        <input type="text" id="quick-invite-input" class="plus-code-input" placeholder="CODE" maxlength="50" required>
        <button type="submit" class="btn btn-primary btn-sm">Join Server</button>
      </form>
    </div>

    <!-- Discoverable Servers Grid -->
    <h2 class="plus-section-title">
      <%= typeof searchQuery !== 'undefined' && searchQuery ? 'Search Results' : 'Featured Communities' %>
      <span style="font-size:0.85rem; color:#949ba4; font-weight:normal; margin-left:8px;">(<%= discoverServers.length %> <%= discoverServers.length === 1 ? 'server' : 'servers' %>)</span>
    </h2>

    <% if (discoverServers.length === 0) { %>
      <div style="background:#2b2d31; border-radius:12px; padding:40px; text-align:center; color:#949ba4;">
        <p style="font-size:1.1rem; color:#f2f3f5; margin:0 0 8px;">No servers found</p>
        <p style="margin:0 0 20px;">Be the first to create a public community server on ClassChat Plus!</p>
        <button type="button" class="btn btn-primary btn-sm" onclick="openPlusModal('create-server-modal')">Create Server</button>
      </div>
    <% } else { %>
      <div class="plus-server-grid">
        <% discoverServers.forEach(function(s) { %>
          <div class="plus-server-card">
            <div class="plus-card-banner">
              <% if (s.banner_path) { %>
                <img src="<%= s.banner_path %>" alt="" loading="lazy">
              <% } %>
            </div>

            <div class="plus-card-icon-wrap">
              <% if (s.icon_path) { %>
                <img src="<%= s.icon_path %>" alt="<%= s.name %>">
              <% } else { %>
                <%= s.name.split(' ').map(function(w) { return w[0]; }).join('').slice(0, 2).toUpperCase() %>
              <% } %>
            </div>

            <div class="plus-card-body">
              <h3 class="plus-card-name" title="<%= s.name %>"><%= s.name %></h3>
              <p class="plus-card-desc"><%= s.description ? s.description : 'Welcome to ' + s.name + '! Join to chat and participate.' %></p>
              
              <div class="plus-card-footer">
                <div class="plus-card-members">
                  <span class="plus-member-dot"></span>
                  <span><%= s.member_count %> <%= s.member_count === 1 ? 'member' : 'members' %></span>
                </div>
                <% if (s.is_member) { %>
                  <a href="/plus/server/<%= s.id %>" class="btn btn-ghost btn-sm" style="font-weight:600;">Open</a>
                <% } else { %>
                  <form action="/plus/invite/<%= s.invite_code %>/join" method="POST" style="margin:0;">
                    <button type="submit" class="btn btn-primary btn-sm">Join</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
</div>

<!-- Create Server Modal -->
<div id="create-server-modal" class="plus-modal-overlay" style="display:<%= typeof createError !== 'undefined' && createError ? 'flex' : 'none' %>;" onclick="if(event.target===this) closePlusModal('create-server-modal')">
  <div class="plus-modal-box" style="max-width:540px; text-align:left;">
    <div class="plus-modal-header">
      <h2 class="plus-modal-title">Create Your Server</h2>
      <button type="button" class="plus-modal-close-btn" onclick="closePlusModal('create-server-modal')">✕</button>
    </div>
    <p class="plus-modal-desc" style="margin-bottom:20px;">
      Your server is where you and your friends or classmates hang out. Make yours and start talking.
    </p>

    <% if (typeof createError !== 'undefined' && createError) { %>
      <div style="background:rgba(239, 68, 68, 0.15); border:1px solid #ef4444; border-radius:8px; padding:10px 14px; margin-bottom:18px; color:#fca5a5; font-size:0.88rem;">
        <%= createError %>
      </div>
    <% } %>

    <form action="/plus/create" method="POST" enctype="multipart/form-data">
      <div class="plus-form-group">
        <label class="plus-form-label">Server Name *</label>
        <input type="text" name="name" class="plus-form-input" placeholder="e.g. 8th Grade Study Squad" maxlength="50" required autofocus>
      </div>

      <div class="plus-form-group">
        <label class="plus-form-label">Description (Optional)</label>
        <textarea name="description" class="plus-form-textarea" rows="2" placeholder="What is your server about?" maxlength="300"></textarea>
      </div>

      <div class="plus-form-group">
        <label class="plus-form-label">Server Icon &amp; Banner (Combined max 5MB)</label>
        <div class="plus-upload-grid">
          <label class="plus-upload-box">
            <input type="file" name="icon" accept="image/*" style="display:none;" onchange="this.nextElementSibling.textContent = this.files[0] ? this.files[0].name : 'Choose Icon';">
            <span style="font-weight:600; color:#f2f3f5; font-size:0.85rem;">Choose Icon</span>
            <div class="plus-upload-hint">Square image recommended</div>
          </label>
          <label class="plus-upload-box">
            <input type="file" name="banner" accept="image/*" style="display:none;" onchange="this.nextElementSibling.textContent = this.files[0] ? this.files[0].name : 'Choose Banner';">
            <span style="font-weight:600; color:#f2f3f5; font-size:0.85rem;">Choose Banner</span>
            <div class="plus-upload-hint">Wide header image</div>
          </label>
        </div>
      </div>

      <div class="plus-form-group">
        <div class="plus-privacy-card">
          <div class="plus-privacy-info">
            <h4>Make Server Discoverable</h4>
            <p>If enabled, your server appears in the Discover page for all students to find and join. If disabled, members can only join with your 6-digit invite link.</p>
          </div>
          <label class="plus-switch">
            <input type="checkbox" name="is_discoverable" value="1" checked>
            <span class="plus-slider"></span>
          </label>
        </div>
      </div>

      <div class="plus-modal-actions" style="margin-top:24px; justify-content:flex-end;">
        <button type="button" class="btn btn-ghost" onclick="closePlusModal('create-server-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary btn-plus-gradient">Create Server</button>
      </div>
    </form>
  </div>
</div>

<script>
function openPlusModal(id) {
  const m = document.getElementById(id);
  if (m) {
    m.style.display = 'flex';
  } else if (id === 'create-server-modal') {
    window.location.href = '/plus/create';
  }
}
function closePlusModal(id) {
  const m = document.getElementById(id);
  if (m) m.style.display = 'none';
}
</script>
<script src="/js/plus.js"></script>
