<div class="plus-invite-page-wrap">
  <div class="plus-invite-ambient-glow"></div>

  <!-- Top Brand Navigation Bar -->
  <a href="/plus" class="plus-invite-brand-bar" title="ClassChat Plus">
    <span style="font-size:1.15rem; line-height:1;">💬</span>
    <span>ClassChat</span>
    <span class="plus-invite-brand-pill-badge">Plus</span>
  </a>

  <!-- Centered Glassmorphic Invitation Card -->
  <div class="plus-invite-card">
    <!-- Server Hero Banner -->
    <div class="plus-invite-banner">
      <% if (server.banner_path) { %>
        <img src="<%= server.banner_path %>" alt="" loading="lazy">
      <% } else { %>
        <div class="plus-invite-banner-mesh"></div>
      <% } %>
      <div class="plus-invite-banner-overlay"></div>
      <% if (server.is_discoverable) { %>
        <div class="plus-invite-banner-badge">
          <span>🌐</span> Public Community
        </div>
      <% } else { %>
        <div class="plus-invite-banner-badge">
          <span>🔒</span> Private Server
        </div>
      <% } %>
    </div>

    <!-- Floating Server Icon -->
    <div class="plus-invite-icon-wrap">
      <div class="plus-invite-icon">
        <% if (server.icon_path) { %>
          <img src="<%= server.icon_path %>" alt="<%= server.name %>">
        <% } else { %>
          <%= server.name.split(' ').map(function(w) { return w[0]; }).join('').slice(0, 2).toUpperCase() %>
        <% } %>
      </div>
    </div>

    <!-- Invite Body & Content -->
    <div class="plus-invite-body">
      <div class="plus-invite-eyebrow">You've been invited to join</div>
      <h1 class="plus-invite-title"><%= server.name %></h1>

      <% if (server.description) { %>
        <div class="plus-invite-desc"><%= server.description %></div>
      <% } %>

      <!-- Server Stats & Metadata -->
      <div class="plus-invite-meta-row">
        <div class="plus-invite-pill">
          <span class="plus-invite-live-dot"></span>
          <span><strong><%= server.member_count %></strong> <%= server.member_count === 1 ? 'Member' : 'Members' %></span>
        </div>
        <% if (typeof server.channel_count !== 'undefined' && server.channel_count > 0) { %>
          <div class="plus-invite-pill">
            <span style="color:#c084fc; font-weight:700;">#</span>
            <span><strong><%= server.channel_count %></strong> <%= server.channel_count === 1 ? 'Channel' : 'Channels' %></span>
          </div>
        <% } %>
        <div class="plus-host-chip">
          <% if (server.owner_avatar_path) { %>
            <img src="<%= server.owner_avatar_path %>" alt="" class="plus-host-avatar">
          <% } else { %>
            <div class="plus-host-avatar"><%= (server.owner_display_name || server.owner_username || '?').charAt(0).toUpperCase() %></div>
          <% } %>
          <span>Hosted by <strong>@<%= server.owner_username %></strong></span>
        </div>
      </div>

      <% if (isLoggedIn) { %>
        <!-- Logged In Identity Badge -->
        <div class="plus-invite-user-badge">
          <div class="plus-invite-user-info">
            <% if (currentUser && currentUser.avatar_path) { %>
              <img src="<%= currentUser.avatar_path %>" alt="" class="plus-invite-user-avatar">
            <% } else { %>
              <div class="plus-invite-user-avatar-placeholder"><%= ((currentUser && currentUser.display_name) || username || '?').charAt(0).toUpperCase() %></div>
            <% } %>
            <div class="plus-invite-user-names">
              <div class="plus-invite-user-label">Joining as</div>
              <div class="plus-invite-user-name">@<%= username %></div>
            </div>
          </div>
          <a href="/logout" class="plus-invite-switch-link">Switch account</a>
        </div>

        <form action="/plus/invite/<%= inviteCode %>/join" method="POST" style="margin:0;">
          <button type="submit" class="btn-plus-invite-accept">
            <span>Accept Invite &amp; Join</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </form>
        <a href="/plus" class="plus-invite-decline-link">No thanks, take me back</a>
      <% } else { %>
        <!-- Guest Actions -->
        <div>
          <a href="/join?login=1" class="btn-plus-invite-login">
            <span>Log In to Accept Invite</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="/join" class="btn-plus-invite-signup">
            New to ClassChat? Sign up with School ID
          </a>
          <a href="/plus" class="plus-invite-decline-link">Explore Discoverable Servers</a>
        </div>
      <% } %>

      <!-- Shareable Code Strip -->
      <div class="plus-invite-code-strip">
        <div class="plus-invite-code-label">
          <span>Invite Code:</span>
          <code><%= inviteCode %></code>
        </div>
        <button type="button" class="plus-invite-copy-btn" id="plus-copy-invite-link" onclick="copyInviteLink('<%= inviteUrl %>')">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span id="copy-btn-text">Copy Link</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function copyInviteLink(url) {
    var btnText = document.getElementById('copy-btn-text');
    function showCopied() {
      if (!btnText) return;
      var orig = btnText.textContent;
      btnText.textContent = 'Copied!';
      setTimeout(function() { btnText.textContent = orig; }, 1800);
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(showCopied).catch(fallback);
    } else {
      fallback();
    }
    function fallback() {
      var ta = document.createElement('textarea');
      ta.value = url;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        showCopied();
      } catch (err) {}
      document.body.removeChild(ta);
    }
  }
</script>
