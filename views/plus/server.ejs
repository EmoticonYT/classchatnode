<% if (typeof error !== 'undefined' && error) { %>
  <div class="plus-alert plus-alert-error">
    <span>⚠️ <%= error %></span>
    <button type="button" onclick="this.parentElement.remove()" class="plus-alert-close">✕</button>
  </div>
<% } %>

<!-- Mobile Drawer Backdrop Overlay -->
<div id="plus-drawer-backdrop" class="plus-drawer-backdrop" onclick="closeAllPlusDrawers()"></div>

<div class="plus-layout-wrap">
  <!-- 1. Left Server Rail -->
  <nav class="plus-server-rail" aria-label="Servers">
    <!-- Discover Button -->
    <div class="plus-rail-item" title="Discover Communities">
      <div class="plus-rail-pill"></div>
      <a href="/plus" class="plus-rail-btn discover-btn" aria-label="Discover Communities">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </a>
    </div>

    <div class="plus-rail-divider"></div>

    <!-- Joined Servers -->
    <% if (typeof userServers !== 'undefined' && userServers.length > 0) { %>
      <% userServers.forEach(function(s) { %>
        <div class="plus-rail-item <%= s.id === server.id ? 'active' : '' %>" title="<%= s.name %>">
          <div class="plus-rail-pill"></div>
          <a href="/plus/server/<%= s.id %>" class="plus-rail-btn <%= s.id === server.id ? 'active-server' : '' %>">
            <% if (s.icon_path) { %>
              <img src="<%= s.icon_path %>" alt="<%= s.name %>" class="plus-rail-img">
            <% } else { %>
              <span class="plus-rail-abbr"><%= s.name.split(' ').map(function(w) { return w[0]; }).join('').slice(0, 3).toUpperCase() %></span>
            <% } %>
          </a>
        </div>
      <% }); %>
    <% } %>

    <!-- Create Server Button -->
    <div class="plus-rail-item" title="Create a Server">
      <div class="plus-rail-pill"></div>
      <button type="button" class="plus-rail-btn create-btn" onclick="openPlusModal('create-server-modal')" aria-label="Create a Server">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- 2. Channels Sidebar -->
  <aside class="plus-channels-sidebar" id="plus-channels-sidebar">
    <!-- Server Banner (if present) -->
    <% if (server.banner_path) { %>
      <div class="plus-server-banner-wrap">
        <img src="<%= server.banner_path %>" alt="" class="plus-server-banner-img">
        <div class="plus-server-banner-overlay"></div>
      </div>
    <% } %>

    <!-- Server Header & Dropdown Trigger -->
    <div class="plus-server-header" onclick="toggleServerMenu(event)">
      <span class="plus-server-title" title="<%= server.name %>"><%= server.name %></span>
      <svg class="plus-server-header-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
      
      <!-- Dropdown Menu -->
      <div id="plus-server-dropdown" class="plus-server-dropdown" style="display:none;" onclick="event.stopPropagation();">
        <button type="button" class="plus-dropdown-btn invite" onclick="openPlusModal('invite-modal'); toggleServerMenu();">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
          <span>Invite People</span>
        </button>
        <% if (isAdmin) { %>
          <button type="button" class="plus-dropdown-btn" onclick="openPlusModal('create-channel-modal'); toggleServerMenu();">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            <span>Create Channel</span>
          </button>
          <button type="button" class="plus-dropdown-btn" onclick="openPlusModal('server-settings-modal'); toggleServerMenu();">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Server Settings</span>
          </button>
        <% } %>
        <% if (!isOwner) { %>
          <div class="plus-dropdown-divider"></div>
          <form action="/plus/server/<%= server.id %>/leave" method="POST" onsubmit="return confirm('Are you sure you want to leave this server?');" style="margin:0;">
            <button type="submit" class="plus-dropdown-btn danger">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
              <span>Leave Server</span>
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <!-- Channels List -->
    <div class="plus-channels-list">
      <div class="plus-channel-category">
        <span>Text Channels</span>
        <% if (isAdmin) { %>
          <button type="button" class="plus-add-channel-btn" title="Create Channel" onclick="openPlusModal('create-channel-modal')">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>
        <% } %>
      </div>

      <% if (typeof channels !== 'undefined' && channels.length > 0) { %>
        <% channels.forEach(function(c) { %>
          <div class="plus-channel-item <%= c.id === currentChannel.id ? 'active' : '' %>">
            <a href="/plus/server/<%= server.id %>/channel/<%= c.id %>" class="plus-channel-link">
              <span class="plus-channel-hash">#</span>
              <span class="plus-channel-name"><%= c.name %></span>
            </a>
            <% if (isAdmin) { %>
              <button type="button" class="plus-channel-gear-btn" title="Channel Settings" onclick="event.preventDefault(); event.stopPropagation(); openEditChannelModal(<%= c.id %>, '<%= c.name %>', '<%= (c.topic || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;') %>')">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
              </button>
            <% } %>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- User Dock -->
    <div class="plus-user-bar">
      <div class="plus-user-bar-avatar" onclick="openMemberCard(<%= currentUser.id %>, '<%= currentUser.username %>', '<%= (currentUser.display_name || currentUser.username).replace(/'/g, "\\'") %>', '<%= currentUser.avatar_path || '' %>', '<%= isOwner ? 'owner' : (isAdmin ? 'admin' : 'member') %>', true)" style="cursor:pointer;" title="Your Mini Profile">
        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.avatar_path) { %>
          <img src="<%= currentUser.avatar_path %>" alt="">
        <% } else { %>
          <div class="avatar-fallback"><%= (typeof currentUser !== 'undefined' && currentUser && (currentUser.display_name || currentUser.username) ? (currentUser.display_name || currentUser.username) : username).charAt(0).toUpperCase() %></div>
        <% } %>
        <span class="plus-online-dot online"></span>
      </div>
      <div class="plus-user-bar-info" onclick="openMemberCard(<%= currentUser.id %>, '<%= currentUser.username %>', '<%= (currentUser.display_name || currentUser.username).replace(/'/g, "\\'") %>', '<%= currentUser.avatar_path || '' %>', '<%= isOwner ? 'owner' : (isAdmin ? 'admin' : 'member') %>', true)" style="cursor:pointer;" title="Your Mini Profile">
        <div class="plus-user-bar-name"><%= typeof currentUser !== 'undefined' && currentUser && currentUser.display_name ? currentUser.display_name : username %></div>
        <div class="plus-user-bar-handle">@<%= username %></div>
      </div>
      <a href="/settings" class="plus-user-bar-btn" title="Settings">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      </a>
    </div>
  </aside>

  <!-- 3. Main Channel Chat Area -->
  <main class="plus-chat-area">
    <!-- Channel Header -->
    <header class="plus-chat-header">
      <div class="plus-chat-header-left">
        <button type="button" class="plus-header-action-btn plus-mobile-toggle-btn" onclick="togglePlusDrawer('channels')" title="Toggle Channels">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
        <div class="plus-chat-header-title">
          <span class="hash">#</span>
          <span class="name"><%= currentChannel.name %></span>
        </div>
        <% if (currentChannel.topic) { %>
          <div class="plus-chat-header-divider"></div>
          <div class="plus-chat-header-topic" title="<%= currentChannel.topic %>"><%= currentChannel.topic %></div>
        <% } %>
      </div>

      <div class="plus-chat-header-right">
        <!-- In-Channel Search -->
        <div class="plus-search-box-wrap">
          <input type="text" id="plus-channel-search-input" class="plus-header-search-input" placeholder="Search #<%= currentChannel.name %>" autocomplete="off" oninput="debounceChannelSearch(this.value)">
          <svg class="plus-header-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <!-- Search Dropdown Results -->
          <div id="plus-search-results-dropdown" class="plus-search-dropdown" style="display:none;"></div>
        </div>

        <!-- Pinned Messages Header Button -->
        <button type="button" class="plus-header-action-btn plus-pins-btn" onclick="openPinnedMessagesModal()" title="Pinned Messages">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"></line><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"></path></svg>
        </button>

        <button type="button" class="plus-header-action-btn" onclick="openPlusModal('invite-modal')" title="Invite People">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
        </button>
        <button type="button" class="plus-header-action-btn plus-toggle-members-btn" onclick="togglePlusDrawer('members')" title="Toggle Members List">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </button>
      </div>
    </header>

    <!-- Scrollable Messages Container -->
    <div class="plus-messages-wrap" id="plus-messages-container">
      <!-- Welcome Header -->
      <div class="plus-channel-welcome">
        <div class="plus-welcome-icon">#</div>
        <h1 class="plus-welcome-title">Welcome to #<%= currentChannel.name %>!</h1>
        <p class="plus-welcome-desc">This is the start of the #<%= currentChannel.name %> channel in <%= server.name %>.</p>
      </div>

      <!-- Messages Stream -->
      <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
        <% messages.forEach(function(m, idx) { 
          const prevMsg = idx > 0 ? messages[idx - 1] : null;
          const isGrouped = prevMsg && prevMsg.sender_id === m.sender_id && (new Date(m.created_at) - new Date(prevMsg.created_at) < 300000);
          const isAuthor = currentUser && currentUser.id === m.sender_id;
          const canDelete = isAuthor || isAdmin;
        %>
          <div class="plus-message-row <%= isGrouped ? 'grouped' : '' %> <%= m.is_pinned ? 'is-pinned-row' : '' %>" data-message-id="<%= m.id %>" data-sender-id="<%= m.sender_id %>" id="msg-row-<%= m.id %>">
            <% if (!isGrouped) { %>
              <div class="plus-msg-avatar" onclick="openMemberCard(<%= m.sender_id %>, '<%= m.username %>', '<%= (m.display_name || m.username).replace(/'/g, "\\'") %>', '<%= m.avatar_path || '' %>', '<%= isOwner && m.sender_id === server.owner_id ? 'owner' : (isAdmin ? 'admin' : 'member') %>')" style="cursor:pointer;" title="View Mini Profile">
                <% if (m.avatar_path) { %>
                  <img src="<%= m.avatar_path %>" alt="" loading="lazy">
                <% } else { %>
                  <div class="avatar-fallback"><%= (m.display_name || m.username || '?').charAt(0).toUpperCase() %></div>
                <% } %>
              </div>
            <% } else { %>
              <div class="plus-msg-grouped-time" title="<%= m.created_at_fmt %>">
                <%= (m.created_at_fmt || '').split(' ')[0] %>
              </div>
            <% } %>

            <div class="plus-msg-content">
              <% if (!isGrouped) { %>
                <div class="plus-msg-header">
                  <a href="javascript:void(0)" onclick="openMemberCard(<%= m.sender_id %>, '<%= m.username %>', '<%= (m.display_name || m.username).replace(/'/g, "\\'") %>', '<%= m.avatar_path || '' %>', '<%= isOwner && m.sender_id === server.owner_id ? 'owner' : (isAdmin ? 'admin' : 'member') %>')" class="plus-msg-author"><%= m.display_name || m.username %></a>
                  <% if (m.is_staff) { %>
                    <span class="badge badge-staff" style="margin-left:4px; font-size:0.68rem; padding:1px 5px;">STAFF</span>
                  <% } %>
                  <span class="plus-msg-time"><%= m.created_at_fmt %></span>
                  <!-- Pinned Badge -->
                  <span class="plus-pinned-tag" id="plus-pinned-tag-<%= m.id %>" style="<%= m.is_pinned ? '' : 'display:none;' %>">
                    📌 Pinned
                  </span>
                </div>
              <% } %>

              <!-- Message Body -->
              <div class="plus-msg-body" id="plus-msg-body-<%= m.id %>"><%= m.body %></div>
              
              <!-- Edited Badge -->
              <span class="plus-msg-edited" id="plus-msg-edited-<%= m.id %>" style="<%= m.edited_at ? '' : 'display:none;' %>" title="<%= m.edited_at_fmt ? 'Edited ' + m.edited_at_fmt : 'Edited' %>">(edited)</span>

              <!-- Attachment Rendering -->
              <% if (m.attachment_path) { %>
                <div class="plus-msg-attachment">
                  <% if (m.attachment_type === 'image') { %>
                    <a href="<%= m.attachment_path %>" target="_blank" class="plus-image-link">
                      <img src="<%= m.attachment_path %>" alt="attachment" loading="lazy">
                    </a>
                  <% } else { %>
                    <div class="plus-file-card">
                      <div class="plus-file-icon">📎</div>
                      <div class="plus-file-info">
                        <a href="<%= m.attachment_path %>" target="_blank" class="plus-file-name" download><%= m.attachment_path.split('/').pop() %></a>
                      </div>
                    </div>
                  <% } %>
                </div>
              <% } %>

              <!-- Message Reactions Container -->
              <div class="plus-msg-reactions" id="plus-msg-reactions-<%= m.id %>">
                <% if (m.reactions && m.reactions.length > 0) { %>
                  <% m.reactions.forEach(function(r) { %>
                    <button type="button" class="plus-reaction-badge <%= r.hasReacted ? 'active' : '' %>" data-emoji="<%= r.emoji %>" onclick="toggleMessageReaction(<%= m.id %>, '<%= r.emoji %>')" title="<%= r.userList %>">
                      <span class="reaction-emoji"><%= r.emoji %></span>
                      <span class="reaction-count"><%= r.count %></span>
                    </button>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <!-- Floating Action Bar on Hover/Focus -->
            <div class="plus-msg-actions">
              <!-- Quick Emoji React Buttons -->
              <div class="plus-quick-emojis">
                <button type="button" class="plus-action-btn" title="React with Heart" onclick="toggleMessageReaction(<%= m.id %>, '❤️')">❤️</button>
                <button type="button" class="plus-action-btn" title="React with Joy" onclick="toggleMessageReaction(<%= m.id %>, '😂')">😂</button>
                <button type="button" class="plus-action-btn" title="React with Thumbs Up" onclick="toggleMessageReaction(<%= m.id %>, '👍')">👍</button>
                <button type="button" class="plus-action-btn" title="React with Fire" onclick="toggleMessageReaction(<%= m.id %>, '🔥')">🔥</button>
                <button type="button" class="plus-action-btn" title="React with Skull" onclick="toggleMessageReaction(<%= m.id %>, '💀')">💀</button>
              </div>

              <div class="plus-action-divider"></div>

              <!-- Copy Text Button (QoL) -->
              <button type="button" class="plus-action-btn" title="Copy Text" onclick="copyMessageText(<%= m.id %>, this)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></line><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              </button>

              <!-- Pin Button (QoL - Admins/Owners) -->
              <% if (isAdmin) { %>
                <button type="button" class="plus-action-btn <%= m.is_pinned ? 'pinned-active' : '' %>" id="pin-btn-<%= m.id %>" title="<%= m.is_pinned ? 'Unpin Message' : 'Pin Message' %>" onclick="togglePinMessage(<%= m.id %>)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"></line><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"></path></svg>
                </button>
              <% } %>

              <!-- Edit Button (Author only) -->
              <% if (isAuthor) { %>
                <button type="button" class="plus-action-btn" title="Edit Message" onclick="startEditingMessage(<%= m.id %>)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                </button>
              <% } %>

              <!-- Delete Button (Author or Admin) -->
              <% if (canDelete) { %>
                <button type="button" class="plus-action-btn danger" title="Delete Message" onclick="deleteMessage(<%= m.id %>)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </button>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Chat Input Area -->
    <div class="plus-chat-input-wrap">
      <div class="plus-typing-indicator" id="plus-typing-status"></div>

      <!-- Attachment Preview Badge -->
      <div id="plus-attachment-preview" class="plus-attachment-preview" style="display:none;">
        <span class="preview-icon">📎</span>
        <span class="preview-filename" id="plus-attachment-filename">file</span>
        <button type="button" class="preview-clear-btn" onclick="clearAttachment()" title="Remove file">✕</button>
      </div>

      <form id="plus-chat-form" action="/plus/server/<%= server.id %>/channel/<%= currentChannel.id %>/message" method="POST" enctype="multipart/form-data" class="plus-input-box">
        <label class="plus-attach-btn" title="Add Attachment" for="plus-file-input">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </label>
        <input type="file" id="plus-file-input" name="file" style="display:none;" onchange="handleFileSelect(this)">

        <textarea id="plus-chat-input" name="body" class="plus-chat-textarea" rows="1" placeholder="Message #<%= currentChannel.name %>" autocomplete="off"></textarea>

        <!-- Quick Emoji Picker Trigger -->
        <button type="button" class="plus-emoji-trigger-btn" onclick="toggleInputEmojiPicker()" title="Emoji Picker">
          😀
        </button>

        <!-- Send Button -->
        <button type="submit" class="plus-send-btn" title="Send Message">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>

        <!-- Quick Emoji Picker Popover -->
        <div id="plus-emoji-picker" class="plus-emoji-picker-popover" style="display:none;">
          <div class="emoji-grid">
            <span onclick="insertEmoji('😀')">😀</span>
            <span onclick="insertEmoji('😂')">😂</span>
            <span onclick="insertEmoji('😍')">😍</span>
            <span onclick="insertEmoji('🔥')">🔥</span>
            <span onclick="insertEmoji('👍')">👍</span>
            <span onclick="insertEmoji('❤️')">❤️</span>
            <span onclick="insertEmoji('💀')">💀</span>
            <span onclick="insertEmoji('🎉')">🎉</span>
            <span onclick="insertEmoji('👀')">👀</span>
            <span onclick="insertEmoji('🚀')">🚀</span>
            <span onclick="insertEmoji('✨')">✨</span>
            <span onclick="insertEmoji('💯')">💯</span>
          </div>
        </div>
      </form>
    </div>
  </main>

  <!-- 4. Members Sidebar -->
  <aside class="plus-members-sidebar" id="plus-members-sidebar">
    <div class="plus-members-group-title">Members — <%= members.length %></div>
    <% members.forEach(function(m) { %>
      <div class="plus-member-row <%= m.role === 'owner' ? 'owner' : (m.role === 'admin' ? 'admin' : '') %>" onclick="openMemberCard(<%= m.id %>, '<%= m.username %>', '<%= (m.display_name || m.username).replace(/'/g, "\\'") %>', '<%= m.avatar_path || '' %>', '<%= m.role %>', <%= m.isOnline ? 'true' : 'false' %>)" style="cursor:pointer;" title="View Mini Profile">
        <div class="plus-member-avatar-wrap">
          <% if (m.avatar_path) { %>
            <img src="<%= m.avatar_path %>" alt="" loading="lazy">
          <% } else { %>
            <div class="avatar-fallback"><%= (m.display_name || m.username || '?').charAt(0).toUpperCase() %></div>
          <% } %>
          <span class="plus-online-dot <%= m.isOnline ? 'online' : '' %>"></span>
        </div>
        <span class="plus-member-name" title="@<%= m.username %>">
          <span class="display-name"><%= m.display_name || m.username %></span>
          <% if (m.role === 'owner') { %>
            <span title="Server Owner" class="role-badge owner">👑</span>
          <% } else if (m.role === 'admin') { %>
            <span title="Server Admin" class="role-badge admin">🛡️</span>
          <% } %>
        </span>
        <% if (isAdmin && m.id !== currentUser.id && m.id !== server.owner_id && (isOwner || m.role !== 'admin')) { %>
          <button type="button" class="plus-mini-mod-btn" title="Manage @<%= m.username %>" onclick="event.stopPropagation(); openPlusModal('server-settings-modal'); openSettingsTab('members');">
            ⚙️
          </button>
        <% } %>
      </div>
    <% }); %>
  </aside>
</div>

<!-- ========================================================
     MODALS & DRAWERS (QoL)
     ======================================================== -->

<!-- 1. Pinned Messages Modal / Drawer (QoL) -->
<div id="pinned-messages-modal" class="plus-modal-overlay" style="display:none;" onclick="if(event.target===this) closePlusModal('pinned-messages-modal')">
  <div class="plus-modal-box plus-pinned-modal-box">
    <div class="plus-modal-header">
      <div style="display:flex; align-items:center; gap:8px;">
        <span style="font-size:1.2rem;">📌</span>
        <h2 class="plus-modal-title">Pinned Messages</h2>
      </div>
      <button type="button" class="plus-modal-close-btn" onclick="closePlusModal('pinned-messages-modal')">✕</button>
    </div>
    <div class="plus-pinned-list" id="plus-pinned-list">
      <div class="plus-pinned-loading">Loading pinned messages...</div>
    </div>
  </div>
</div>

<!-- 2. Member Mini-Profile Card (QoL) -->
<div id="member-card-modal" class="plus-modal-overlay" style="display:none;" onclick="if(event.target===this) closePlusModal('member-card-modal')">
  <div class="plus-modal-box plus-member-card-box">
    <div class="plus-member-card-banner">
      <button type="button" class="plus-modal-close-btn plus-card-close" onclick="closePlusModal('member-card-modal')">✕</button>
    </div>
    <div class="plus-member-card-avatar-wrap">
      <div id="card-avatar-container"></div>
      <span id="card-online-dot" class="plus-online-dot online"></span>
    </div>
    <div class="plus-member-card-content">
      <h3 id="card-display-name" class="plus-card-user-name">User</h3>
      <div id="card-username" class="plus-card-user-handle">@user</div>
      <div id="card-role-badge" class="plus-role-tag">Member</div>

      <hr class="plus-modal-divider" style="margin:16px 0 14px;">

      <div class="plus-card-actions">
        <a id="card-dm-link" href="#" class="btn btn-primary btn-sm btn-plus-gradient">
          💬 Send Direct Message
        </a>
        <a id="card-profile-link" href="#" class="btn btn-ghost btn-sm">
          👤 View Profile
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Create Server Modal -->
<div id="create-server-modal" class="plus-modal-overlay" style="display:none;" onclick="if(event.target===this) closePlusModal('create-server-modal')">
  <div class="plus-modal-box" style="max-width:540px; text-align:left;">
    <div class="plus-modal-header">
      <h2 class="plus-modal-title">Create Your Server</h2>
      <button type="button" class="plus-modal-close-btn" onclick="closePlusModal('create-server-modal')">✕</button>
    </div>
    <p class="plus-modal-desc" style="margin-bottom:20px;">
      Your server is where you and your friends or classmates hang out. Make yours and start talking.
    </p>

    <form action="/plus/create" method="POST" enctype="multipart/form-data">
      <div class="plus-form-group">
        <label class="plus-form-label">Server Name *</label>
        <input type="text" name="name" class="plus-form-input" placeholder="e.g. 8th Grade Study Squad" maxlength="50" required autofocus>
      </div>

      <div class="plus-form-group">
        <label class="plus-form-label">Description (Optional)</label>
        <textarea name="description" class="plus-form-textarea" rows="2" placeholder="What is your server about?" maxlength="300"></textarea>
      </div>

      <div class="plus-form-group">
        <label class="plus-form-label">Server Icon &amp; Banner (Combined max 5MB)</label>
        <div class="plus-upload-grid">
          <label class="plus-upload-box">
            <input type="file" name="icon" accept="image/*" style="display:none;" onchange="this.nextElementSibling.textContent = this.files[0] ? this.files[0].name : 'Choose Icon';">
            <span style="font-weight:600; color:#f2f3f5; font-size:0.85rem;">Choose Icon</span>
            <div class="plus-upload-hint">Square image recommended</div>
          </label>
          <label class="plus-upload-box">
            <input type="file" name="banner" accept="image/*" style="display:none;" onchange="this.nextElementSibling.textContent = this.files[0] ? this.files[0].name : 'Choose Banner';">
            <span style="font-weight:600; color:#f2f3f5; font-size:0.85rem;">Choose Banner</span>
            <div class="plus-upload-hint">Wide header image</div>
          </label>
        </div>
      </div>

      <div class="plus-form-group">
        <div class="plus-privacy-card">
          <div class="plus-privacy-info">
            <h4>Make Server Discoverable</h4>
            <p>If enabled, your server appears in the Discover page for all students to find and join. If disabled, members can only join with your 6-digit invite link.</p>
          </div>
          <label class="plus-switch">
            <input type="checkbox" name="is_discoverable" value="1" checked>
            <span class="plus-slider"></span>
          </label>
        </div>
      </div>

      <div class="plus-modal-actions" style="margin-top:24px; justify-content:flex-end;">
        <button type="button" class="btn btn-ghost" onclick="closePlusModal('create-server-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary btn-plus-gradient">Create Server</button>
      </div>
    </form>
  </div>
</div>

<!-- 3. Invite Modal -->
<div id="invite-modal" class="plus-modal-overlay" style="display:none;" onclick="if(event.target===this) closePlusModal('invite-modal')">
  <div class="plus-modal-box">
    <div class="plus-modal-header">
      <h2 class="plus-modal-title">Invite Friends to <%= server.name %></h2>
      <button type="button" class="plus-modal-close-btn" onclick="closePlusModal('invite-modal')">✕</button>
    </div>
    <p class="plus-modal-desc">
      Share this link with classmates or friends to invite them to this server.
    </p>

    <div class="plus-form-group">
      <label class="plus-form-label">Server Invite Link</label>
      <div style="display:flex; gap:8px;">
        <input type="text" id="server-invite-url-input" class="plus-form-input" value="<%= inviteUrl %>" readonly style="font-family:monospace; font-size:0.88rem;">
        <button type="button" class="btn btn-primary btn-plus-gradient" onclick="copyPlusInviteLink(this, '<%= inviteUrl %>')">Copy</button>
      </div>
      <div style="font-size:0.8rem; color:#949ba4; margin-top:8px;">
        Public Link: <code style="color:var(--accent); background:rgba(0,0,0,0.3); padding:3px 7px; border-radius:6px;">classchat.emoticonyt.site/plus/invite/<%= inviteCode %></code>
      </div>
    </div>

    <div class="plus-form-group">
      <label class="plus-form-label">Invite Code</label>
      <div class="plus-invite-code-pill"><%= inviteCode %></div>
    </div>

    <div class="plus-modal-actions">
      <button type="button" class="btn btn-ghost" onclick="closePlusModal('invite-modal')">Close</button>
    </div>
  </div>
</div>

<!-- 4. Create Channel Modal -->
<% if (isAdmin) { %>
<div id="create-channel-modal" class="plus-modal-overlay" style="display:none;" onclick="if(event.target===this) closePlusModal('create-channel-modal')">
  <div class="plus-modal-box">
    <div class="plus-modal-header">
      <h2 class="plus-modal-title">Create Channel</h2>
      <button type="button" class="plus-modal-close-btn" onclick="closePlusModal('create-channel-modal')">✕</button>
    </div>
    <form action="/plus/server/<%= server.id %>/channels" method="POST">
      <div class="plus-form-group">
        <label class="plus-form-label">Channel Name *</label>
        <div style="position:relative;">
          <span style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--text-muted); font-weight:700;">#</span>
          <input type="text" name="name" class="plus-form-input" style="padding-left:30px;" placeholder="e.g. general-chat" maxlength="30" required autofocus>
        </div>
      </div>
      <div class="plus-form-group">
        <label class="plus-form-label">Channel Topic (Optional)</label>
        <input type="text" name="topic" class="plus-form-input" placeholder="What is this channel about?" maxlength="150">
      </div>
      <div class="plus-modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closePlusModal('create-channel-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary btn-plus-gradient">Create Channel</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<!-- 5. Edit Channel Modal -->
<% if (isAdmin) { %>
<div id="edit-channel-modal" class="plus-modal-overlay" style="display:none;" onclick="if(event.target===this) closePlusModal('edit-channel-modal')">
  <div class="plus-modal-box">
    <div class="plus-modal-header">
      <h2 class="plus-modal-title">Channel Settings</h2>
      <button type="button" class="plus-modal-close-btn" onclick="closePlusModal('edit-channel-modal')">✕</button>
    </div>
    
    <form id="edit-channel-form" action="" method="POST">
      <div class="plus-form-group">
        <label class="plus-form-label">Channel Name *</label>
        <div style="position:relative;">
          <span style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--text-muted); font-weight:700;">#</span>
          <input type="text" id="edit-channel-name-input" name="name" class="plus-form-input" style="padding-left:30px;" maxlength="30" required>
        </div>
      </div>

      <div class="plus-form-group">
        <label class="plus-form-label">Channel Topic (Optional)</label>
        <input type="text" id="edit-channel-topic-input" name="topic" class="plus-form-input" placeholder="What is this channel about?" maxlength="150">
      </div>

      <div class="plus-modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closePlusModal('edit-channel-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary btn-plus-gradient">Save Changes</button>
      </div>
    </form>

    <hr class="plus-modal-divider">

    <!-- Danger Zone for Channel -->
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <div>
        <strong style="color:#ef4444; font-size:0.9rem;">Delete Channel</strong>
        <p style="color:var(--text-muted); font-size:0.78rem; margin:2px 0 0;">
          <% if (channels.length <= 1) { %>
            Cannot delete the only channel in this server.
          <% } else { %>
            Permanently delete this channel and its messages.
          <% } %>
        </p>
      </div>
      <form id="delete-channel-form" action="" method="POST" onsubmit="return confirm('Are you sure you want to delete this channel? All messages will be permanently lost.');" style="margin:0;">
        <% if (channels.length <= 1) { %>
          <button type="button" class="btn btn-sm" disabled style="background:#ef4444; color:#fff; border:none; opacity:0.4; cursor:not-allowed;" title="Cannot delete the only channel">Delete</button>
        <% } else { %>
          <button type="submit" class="btn btn-sm" style="background:#ef4444; color:#fff; border:none;">Delete</button>
        <% } %>
      </form>
    </div>
  </div>
</div>
<% } %>

<!-- 6. Ban User Modal -->
<% if (isAdmin) { %>
<div id="ban-user-modal" class="plus-modal-overlay" style="display:none;" onclick="if(event.target===this) closePlusModal('ban-user-modal')">
  <div class="plus-modal-box">
    <div class="plus-modal-header">
      <h2 class="plus-modal-title" style="color:#ef4444;">Ban Member</h2>
      <button type="button" class="plus-modal-close-btn" onclick="closePlusModal('ban-user-modal')">✕</button>
    </div>
    <p class="plus-modal-desc">
      Are you sure you want to ban <strong id="ban-modal-username" style="color:#ffffff;">@user</strong>? They will be removed and blocked from rejoining via invite links.
    </p>

    <form id="ban-user-form" action="" method="POST">
      <div class="plus-form-group">
        <label class="plus-form-label">Reason for Ban (Optional)</label>
        <input type="text" id="ban-modal-reason-input" name="reason" class="plus-form-input" placeholder="e.g. Inappropriate behavior, spamming" maxlength="150">
      </div>

      <div class="plus-modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closePlusModal('ban-user-modal')">Cancel</button>
        <button type="submit" class="btn btn-sm" style="background:#ef4444; color:#fff; border:none; padding:8px 16px; font-weight:600; border-radius:8px;">Confirm Ban</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<!-- 7. Server Settings Modal -->
<% if (isAdmin) { %>
<div id="server-settings-modal" class="plus-modal-overlay" style="display:none;" onclick="if(event.target===this) closePlusModal('server-settings-modal')">
  <div class="plus-modal-box plus-settings-modal-dialog">
    <!-- Modal Header with Tabs -->
    <div class="plus-settings-header">
      <div class="plus-settings-title-wrap">
        <h2><%= server.name %> — Settings</h2>
      </div>
      <div class="plus-settings-tabs">
        <button type="button" class="plus-tab-btn active" id="tab-btn-overview" onclick="openSettingsTab('overview')">Overview</button>
        <button type="button" class="plus-tab-btn" id="tab-btn-members" onclick="openSettingsTab('members')">Members (<%= members.length %>)</button>
        <button type="button" class="plus-tab-btn" id="tab-btn-bans" onclick="openSettingsTab('bans')">Bans (<%= bannedUsers.length %>)</button>
      </div>
      <button type="button" class="plus-modal-close-btn" onclick="closePlusModal('server-settings-modal')">✕</button>
    </div>

    <!-- Modal Body -->
    <div class="plus-settings-body">
      <!-- TAB 1: OVERVIEW -->
      <div id="settings-tab-overview" class="plus-settings-tab-content">
        <form action="/plus/server/<%= server.id %>/settings" method="POST" enctype="multipart/form-data">
          <div class="plus-form-group">
            <label class="plus-form-label">Server Name</label>
            <input type="text" name="name" class="plus-form-input" value="<%= server.name %>" maxlength="50" required>
          </div>

          <div class="plus-form-group">
            <label class="plus-form-label">Description</label>
            <textarea name="description" class="plus-form-input" rows="3" maxlength="300"><%= server.description || '' %></textarea>
          </div>

          <div class="plus-form-group">
            <label class="plus-form-label">Server Icon</label>
            <input type="file" name="icon" class="plus-form-input" accept="image/*">
          </div>

          <div class="plus-form-group">
            <label class="plus-form-label">Server Banner</label>
            <input type="file" name="banner" class="plus-form-input" accept="image/*">
          </div>

          <div class="plus-form-group">
            <label class="plus-checkbox-label">
              <input type="checkbox" name="is_discoverable" value="1" <%= server.is_discoverable ? 'checked' : '' %>>
              <span>Show in Discover Communities</span>
            </label>
          </div>

          <div class="plus-modal-actions" style="margin-top:20px;">
            <button type="submit" class="btn btn-primary btn-plus-gradient">Save Changes</button>
          </div>
        </form>

        <% if (isOwner) { %>
          <hr class="plus-modal-divider">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
              <strong style="color:#ef4444;">Delete Server</strong>
              <p style="color:var(--text-muted); font-size:0.8rem; margin:2px 0 0;">Permanently delete this server, all channels, and all messages.</p>
            </div>
            <form action="/plus/server/<%= server.id %>/delete" method="POST" onsubmit="return confirm('DANGER: Are you absolutely sure you want to delete <%= server.name %>? This cannot be undone.');">
              <button type="submit" class="btn btn-sm" style="background:#ef4444; color:#fff; border:none;">Delete Server</button>
            </form>
          </div>
        <% } %>
      </div>

      <!-- TAB 2: MEMBERS -->
      <div id="settings-tab-members" class="plus-settings-tab-content" style="display:none;">
        <div class="plus-settings-members-list">
          <% members.forEach(function(m) { %>
            <div class="plus-settings-member-card">
              <div class="plus-member-avatar-wrap">
                <% if (m.avatar_path) { %>
                  <img src="<%= m.avatar_path %>" alt="">
                <% } else { %>
                  <div class="avatar-fallback"><%= (m.display_name || m.username || '?').charAt(0).toUpperCase() %></div>
                <% } %>
                <span class="plus-online-dot <%= m.isOnline ? 'online' : '' %>"></span>
              </div>

              <div class="plus-settings-member-meta">
                <div class="plus-settings-member-name">
                  <span class="name"><%= m.display_name || m.username %></span>
                  <span class="handle">@<%= m.username %></span>
                </div>
                <div class="plus-role-tag <%= m.role %>">
                  <% if (m.role === 'owner') { %>👑 Owner
                  <% } else if (m.role === 'admin') { %>🛡️ Admin
                  <% } else { %>Member<% } %>
                </div>
              </div>

              <div class="plus-settings-item-actions">
                <% if (isOwner && m.id !== server.owner_id) { %>
                  <form action="/plus/server/<%= server.id %>/members/<%= m.id %>/role" method="POST" style="margin:0;">
                    <select name="role" class="plus-role-select" onchange="this.form.submit()" title="Change Member Role">
                      <option value="member" <%= m.role === 'member' ? 'selected' : '' %>>Member</option>
                      <option value="admin" <%= m.role === 'admin' ? 'selected' : '' %>>🛡️ Admin</option>
                    </select>
                  </form>
                <% } %>

                <% if (m.id !== currentUser.id && m.id !== server.owner_id && (isOwner || (isAdmin && m.role !== 'admin'))) { %>
                  <form action="/plus/server/<%= server.id %>/members/<%= m.id %>/kick" method="POST" onsubmit="return confirm('Kick @<%= m.username %> from this server?');" style="margin:0;">
                    <button type="submit" class="btn btn-sm btn-ghost" style="color:#f59e0b; border:1px solid rgba(245, 158, 11, 0.3);">Kick</button>
                  </form>
                  <button type="button" class="btn btn-sm" style="background:rgba(239, 68, 68, 0.15); color:#ef4444; border:1px solid rgba(239, 68, 68, 0.3);" onclick="openBanModal(<%= m.id %>, '<%= m.username %>')">Ban</button>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- TAB 3: BANS -->
      <div id="settings-tab-bans" class="plus-settings-tab-content" style="display:none;">
        <% if (bannedUsers && bannedUsers.length > 0) { %>
          <div class="plus-settings-bans-list">
            <% bannedUsers.forEach(function(b) { %>
              <div class="plus-settings-ban-card">
                <div class="plus-member-avatar-wrap">
                  <% if (b.avatar_path) { %>
                    <img src="<%= b.avatar_path %>" alt="">
                  <% } else { %>
                    <div class="avatar-fallback"><%= (b.display_name || b.username || '?').charAt(0).toUpperCase() %></div>
                  <% } %>
                </div>
                <div class="plus-settings-member-meta">
                  <div class="plus-settings-member-name">
                    <span class="name"><%= b.display_name || b.username %></span>
                    <span class="handle">@<%= b.username %></span>
                  </div>
                  <div style="font-size:0.8rem; color:var(--text-muted); margin-top:2px;">
                    Reason: <span style="color:#f87171;"><%= b.reason || 'No reason provided' %></span>
                  </div>
                </div>
                <div class="plus-settings-item-actions">
                  <form action="/plus/server/<%= server.id %>/bans/<%= b.user_id %>/unban" method="POST" onsubmit="return confirm('Unban @<%= b.username %>?');" style="margin:0;">
                    <button type="submit" class="btn btn-sm btn-primary btn-plus-gradient">Unban</button>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div style="text-align:center; padding:36px 16px; color:var(--text-muted);">
            <div style="font-size:2rem; margin-bottom:8px;">🕊️</div>
            <div style="font-weight:600; color:#fff;">No banned users</div>
            <div style="font-size:0.85rem;">Users banned from this server will appear here.</div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Global Page State for Scripts -->
<script>
window.__PLUS_SERVER_ID__ = <%= server.id %>;
window.__PLUS_CHANNEL_ID__ = <%= currentChannel.id %>;
window.__PLUS_USER_ID__ = <%= currentUser.id %>;
window.__PLUS_IS_ADMIN__ = <%= isAdmin ? 'true' : 'false' %>;

function toggleServerMenu(e) {
  if (e) e.stopPropagation();
  const menu = document.getElementById('plus-server-dropdown');
  if (menu) {
    menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
  }
}
document.addEventListener('click', function(e) {
  const header = document.querySelector('.plus-server-header');
  const menu = document.getElementById('plus-server-dropdown');
  if (menu && header && !header.contains(e.target)) {
    menu.style.display = 'none';
  }
});

function openPlusModal(id) {
  const m = document.getElementById(id);
  if (m) m.style.display = 'flex';
}
function closePlusModal(id) {
  const m = document.getElementById(id);
  if (m) m.style.display = 'none';
}

function openEditChannelModal(id, name, topic) {
  const form = document.getElementById('edit-channel-form');
  const delForm = document.getElementById('delete-channel-form');
  const nameInput = document.getElementById('edit-channel-name-input');
  const topicInput = document.getElementById('edit-channel-topic-input');
  if (form) form.action = '/plus/server/<%= server.id %>/channel/' + id + '/edit';
  if (delForm) delForm.action = '/plus/server/<%= server.id %>/channel/' + id + '/delete';
  if (nameInput) nameInput.value = name;
  if (topicInput) topicInput.value = topic;
  openPlusModal('edit-channel-modal');
}

function openBanModal(userId, username) {
  const form = document.getElementById('ban-user-form');
  const userEl = document.getElementById('ban-modal-username');
  if (form) form.action = '/plus/server/<%= server.id %>/members/' + userId + '/ban';
  if (userEl) userEl.textContent = '@' + username;
  openPlusModal('ban-user-modal');
}

function openSettingsTab(tabName) {
  ['overview', 'members', 'bans'].forEach(t => {
    const tab = document.getElementById('settings-tab-' + t);
    const btn = document.getElementById('tab-btn-' + t);
    if (tab) tab.style.display = (t === tabName) ? 'block' : 'none';
    if (btn) {
      if (t === tabName) btn.classList.add('active');
      else btn.classList.remove('active');
    }
  });
}

function copyPlusInviteLink(btn, url) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(url).then(function() {
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(function() { btn.textContent = orig; }, 2000);
    });
  } else {
    const inp = document.getElementById('server-invite-url-input');
    if (inp) {
      inp.select();
      document.execCommand('copy');
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(function() { btn.textContent = orig; }, 2000);
    }
  }
}

function handleFileSelect(input) {
  const preview = document.getElementById('plus-attachment-preview');
  const filename = document.getElementById('plus-attachment-filename');
  if (input.files && input.files[0]) {
    filename.textContent = input.files[0].name;
    preview.style.display = 'flex';
  } else {
    preview.style.display = 'none';
  }
}

function clearAttachment() {
  const fileInput = document.getElementById('plus-file-input');
  const preview = document.getElementById('plus-attachment-preview');
  if (fileInput) fileInput.value = '';
  if (preview) preview.style.display = 'none';
}

function toggleInputEmojiPicker() {
  const p = document.getElementById('plus-emoji-picker');
  if (p) p.style.display = p.style.display === 'none' ? 'block' : 'none';
}

function insertEmoji(emoji) {
  const inp = document.getElementById('plus-chat-input');
  if (inp) {
    inp.value += emoji;
    inp.focus();
  }
  const p = document.getElementById('plus-emoji-picker');
  if (p) p.style.display = 'none';
}
</script>
<script src="/js/plus.js"></script>
