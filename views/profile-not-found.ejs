<header class="app-header">
  <div class="header-inner">
    <a href="/feed" class="brand">
      <span class="logo-icon">💬</span>
      <span>ClassChat</span>
    </a>
    <nav class="nav-links">
      <a href="/feed">Feed</a>
    </nav>
    <div class="header-right">
      <a href="/logout" class="btn btn-ghost">Log out</a>
